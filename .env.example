# Local development / persistent single-host storage only. Never enables SQLite on Vercel.
DATABASE_PATH=./data/road.db
# Required on Vercel. Both blank selects local SQLite outside Vercel.
# Remote libSQL database URL (libsql:// or https://), no file replicas.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Private Blob store read-write token (server only; used to sign scoped upload tokens). Blank selects local media outside Vercel.
BLOB_READ_WRITE_TOKEN=
# Required for admin provisioning, never expose to browser
ADMIN_PASSWORD=
# Public canonical URL for metadata
SITE_URL=http://localhost:3000
# Set to 1 ONLY behind a trusted proxy that overwrites X-Real-IP;
# block direct access to the origin server. Otherwise local global login bucket is used.
TRUST_PROXY_IP=0
