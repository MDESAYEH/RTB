# انسخه إلى /var/www/roadtobal/.env.production واملأ القيم
SITE_URL=https://roadtobal27.ly
# سر طويل عشوائي:  openssl rand -hex 32
CRON_SECRET=
# 1 فقط لأن nginx أمام التطبيق ويستبدل X-Real-IP
TRUST_PROXY_IP=1
DATABASE_PATH=/var/www/roadtobal/data/road.db
BACKUP_DIRECTORY=/var/backups/roadtobal
# عدد النسخ الاحتياطية اليومية المحتفظ بها (الأقدم تُحذف)
BACKUP_KEEP=14
# لا تضع TURSO_* ولا BLOB_READ_WRITE_TOKEN (وضع SQLite المحلي)
# لا تضع ADMIN_PASSWORD هنا (للطرفية فقط عند admin:create)
# مفتاح تشفير أسرار تطبيق المصادقة المخزنة في قاعدة البيانات (32 حرفاً فأكثر):  openssl rand -hex 32
# احفظه في مكان آمن: إن ضاع لا يمكن فك أسرار المصادقة المخزنة وسيلزم إعادة تعيينها لكل حساب.
TWO_FACTOR_KEY=
# 1 = إلزام كل حساب بتفعيل التحقق الثنائي (يُطلب الرمز عند كل دخول). اتركه 0 حتى يُفعّل الجميع.
REQUIRE_2FA=0
# مزامنة FIBA تُبقي كل فريق في مجموعته المحلية (توزيع 5 / 5 من سجل الفرق) وتحدّث النتائج والأخبار والتفاصيل فقط.
# ضع 1 فقط إذا أردت أن تتبع المزامنة جداول مجموعات FIBA وتنقل الفرق بينها.
FIBA_FOLLOW_GROUPS=0
